####
# Multi-stage JVM image for library-function. The build context is the repository root, because
# library-function depends on the shared-lib module:
#
#   docker build -f library-function/src/main/docker/Dockerfile.jvm -t library-platform/library-function-jvm .
#
# or simply `docker compose up --build` from the repository root.
#
# Build arg MAVEN_REPO_URL lets you point Maven at a mirror (defaults to Maven Central).
####

FROM maven:3.9-eclipse-temurin-21 AS build
ARG MAVEN_REPO_URL=https://repo.maven.apache.org/maven2
WORKDIR /build
RUN mkdir -p /root/.m2 && printf '%s\n' \
    '<settings><mirrors><mirror><id>build-mirror</id><mirrorOf>*</mirrorOf>' \
    "<url>${MAVEN_REPO_URL}</url></mirror></mirrors></settings>" > /root/.m2/settings.xml
COPY pom.xml .
COPY shared-lib shared-lib
COPY library-function library-function
RUN --mount=type=cache,target=/root/.m2/repository \
    mvn -B -q -DskipTests package

FROM registry.access.redhat.com/ubi9/openjdk-21-runtime:1.24

ENV LANGUAGE='en_US:en'
ENV TZ=America/Sao_Paulo

COPY --from=build --chown=185 /build/library-function/target/quarkus-app/lib/ /deployments/lib/
COPY --from=build --chown=185 /build/library-function/target/quarkus-app/*.jar /deployments/
COPY --from=build --chown=185 /build/library-function/target/quarkus-app/app/ /deployments/app/
COPY --from=build --chown=185 /build/library-function/target/quarkus-app/quarkus/ /deployments/quarkus/

EXPOSE 8080
USER 185
ENV JAVA_OPTS_APPEND="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager -Duser.timezone=America/Sao_Paulo"
ENV JAVA_APP_JAR="/deployments/quarkus-run.jar"

ENTRYPOINT [ "/opt/jboss/container/java/run/run-java.sh" ]
